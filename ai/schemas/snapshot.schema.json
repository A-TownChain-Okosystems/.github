{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "atc://schemas/snapshot.schema.json",
  "title": "ATC Registry Snapshot",
  "type": "object",
  "required": [
    "agent",
    "approved_standards",
    "binding",
    "candidate_standards",
    "created",
    "draft_standards",
    "registry_commit",
    "registry_hash",
    "registry_status",
    "registry_version",
    "snapshot_id",
    "task"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string"
    },
    "created": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "registry_version": {
      "type": "string"
    },
    "registry_commit": {
      "type": "string"
    },
    "registry_hash": {
      "type": "string"
    },
    "approved_standards": {
      "type": "integer"
    },
    "registry_status": {
      "type": "object"
    },
    "candidate_standards": {
      "type": "integer"
    },
    "draft_standards": {
      "type": "integer"
    },
    "binding": {
      "type": "object"
    }
  }
}